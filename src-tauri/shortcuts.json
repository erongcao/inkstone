  "accelerators": {
    "new-document": "CmdOrCtrl+N",
    "open-document": "CmdOrCtrl+O",
    "save-document": "CmdOrCtrl+S",
    "save-document-as": "CmdOrCtrl+Shift+S",
    "export-document": "CmdOrCtrl+Shift+E",
    "preferences": "CmdOrCtrl+,",
    "find": "CmdOrCtrl+F",
    "replace": "Ctrl+H",
    "copy-as-markdown": "CmdOrCtrl+Shift+C",
    "copy-as-html": "CmdOrCtrl+Alt+C",
    "paste-as-plain-text": "CmdOrCtrl+Shift+V",
    "toggle-sidebar": "CmdOrCtrl+Alt+B",
    "toggle-source-mode": "CmdOrCtrl+/",
    "toggle-focus-mode": "CmdOrCtrl+Shift+F",
    "toggle-typewriter-mode": "CmdOrCtrl+Shift+T",
    "zoom-in": "CmdOrCtrl+Equal",
    "zoom-out": "CmdOrCtrl+Minus",
    "zoom-reset": "CmdOrCtrl+0"
  }
}
