{
  "actions": [
    "new-document",
    "open-document",
    "save-document",
    "save-document-as",
    "export-document",
    "preferences",
    "find",
    "replace",
    "copy-as-markdown",
    "copy-as-html",
    "paste-as-plain-text",
    "toggle-sidebar",
    "toggle-source-mode",
    "toggle-focus-mode",
    "toggle-typewriter-mode",
    "zoom-in",
